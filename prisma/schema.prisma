// StayHub data model. Money is stored in minor units (cents) as Int.
// Dates for stays are stored as UTC midnight DateTime; a stay covers [checkIn, checkOut).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- Auth (Auth.js adapter tables + app user) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("GUEST") // GUEST | HOST | ADMIN
  createdAt     DateTime  @default(now())

  // Stripe Connect (host payouts) — populated in the Stripe phase
  stripeAccountId String? @unique
  payoutsEnabled  Boolean @default(false)

  accounts   Account[]
  sessions   Session[]
  properties Property[]
  bookings   Booking[]
  reviews    Review[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Marketplace ----------

model Property {
  id           String   @id @default(cuid())
  hostId       String
  title        String
  description  String
  type         String // HOTEL | APARTMENT | HOUSE | ROOM
  address      String
  city         String
  country      String
  lat          Float?
  lng          Float?
  currency     String   @default("USD")
  amenities    String   @default("[]") // JSON string[]
  checkInTime  String   @default("15:00")
  checkOutTime String   @default("11:00")
  status       String   @default("DRAFT") // DRAFT | PUBLISHED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  host      User            @relation(fields: [hostId], references: [id], onDelete: Cascade)
  images    PropertyImage[]
  roomTypes RoomType[]
  bookings  Booking[]
  reviews   Review[]

  @@index([city])
  @@index([status])
}

model PropertyImage {
  id         String @id @default(cuid())
  propertyId String
  url        String
  order      Int    @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

/**
 * A bookable unit category. Hotels have several (e.g. "Double Room" x 12);
 * apartments/houses have exactly one ("Entire place" x 1).
 */
model RoomType {
  id            String @id @default(cuid())
  propertyId    String
  name          String
  description   String @default("")
  pricePerNight Int // minor units, in the property currency
  maxGuests     Int    @default(2)
  bedrooms      Int    @default(1)
  beds          Int    @default(1)
  bathrooms     Int    @default(1)
  quantity      Int    @default(1) // identical units available per night
  order         Int    @default(0)

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  blockedDates BlockedDate[]
  bookings     Booking[]

  @@index([propertyId])
}

/**
 * Host-blocked night: all units of the room type are unavailable on this date.
 */
model BlockedDate {
  id         String   @id @default(cuid())
  roomTypeId String
  date       DateTime

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
}

model Booking {
  id          String   @id @default(cuid())
  propertyId  String
  roomTypeId  String
  guestId     String
  checkIn     DateTime
  checkOut    DateTime
  guests      Int
  nights      Int
  totalAmount Int // minor units
  status      String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  guest    User     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  payment  Payment?
  review   Review?

  @@index([roomTypeId, checkIn, checkOut])
  @@index([guestId])
}

model Payment {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  amount      Int
  provider    String   @default("MOCK") // MOCK | STRIPE
  status      String   @default("PAID") // PAID | REFUNDED | FAILED
  providerRef String?
  createdAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  propertyId String
  authorId   String
  rating     Int // 1..5
  comment    String
  createdAt  DateTime @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}
