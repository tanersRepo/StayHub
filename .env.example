DATABASE_URL="file:./dev.db"
AUTH_SECRET="dev-secret-change-me-please-0123456789"
# Trust the request's own host so login works on localhost, a LAN address and a VS Code tunnel.
# Don't set AUTH_URL in development: it pins every login redirect to that one address.
# In production, set AUTH_URL to the public site address instead.
AUTH_TRUST_HOST=true
# Optional Google login
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Support widget (bottom-right chat bubble): messages are emailed via Resend (resend.com).
# Without a verified domain, Resend only delivers to the email address that owns the account.
# If unset, messages are printed to the dev server console instead.
# RESEND_API_KEY=
# SUPPORT_TO_EMAIL=you@example.com
# SUPPORT_FROM_EMAIL="StayHub Support <onboarding@resend.dev>"
